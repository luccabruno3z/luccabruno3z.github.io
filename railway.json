{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "bot/**",
      "logos/**",
      "requirements.txt",
      "nixpacks.toml",
      "Procfile",
      ".dockerignore",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m bot",
    "restartPolicyType": "ALWAYS",
    "sleepApplication": true
  }
}
